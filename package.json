{
  "name": "cheonsu",
  "private": true,
  "version": "1.99.133",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "maps:final-variants": "powershell.exe -ExecutionPolicy Bypass -File scripts/generate-stage-final-map-variants.ps1",
    "sprites:enemy-variants": "powershell.exe -ExecutionPolicy Bypass -File scripts/generate-enemy-variants.ps1",
    "preview": "vite preview",
    "cap:copy": "npm run build && npx cap copy",
    "cap:sync": "npm run build && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "node scripts/build-android.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:ui": "node scripts/verify-combat-patch.cjs && node scripts/verify-combat-motion.cjs && node scripts/verify-battle-controls.cjs",
    "art:combat": "node scripts/prepare-combat-art.cjs",
    "art:motion": "node scripts/prepare-combat-motion.cjs",
    "package:source": "node scripts/package-source.mjs",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "archiver": "^8.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^8.0.12"
  }
}
